<?xml version="1.0" encoding="UTF-8"?>
<robot name="mycobot_280_jn">
    <group name="mycobot_arm">
        <chain base_link="mycobot_base_link" tip_link="pump_tcp"/>
    </group>

    <!-- Suction pump end effector group -->
    <group name="pump">
        <link name="pump_head"/>
        <link name="pump_tcp"/>
    </group>
    <end_effector name="suction_pump" parent_link="link6" group="pump"/>
    <group_state name="home" group="mycobot_arm">
        <joint name="joint2_to_joint1" value="0"/>
        <joint name="joint3_to_joint2" value="0"/>
        <joint name="joint4_to_joint3" value="0"/>
        <joint name="joint5_to_joint4" value="0"/>
        <joint name="joint6_to_joint5" value="0"/>
        <joint name="joint6output_to_joint6" value="0"/>
    </group_state>
    <virtual_joint name="virtual_joint" type="fixed" parent_frame="map" child_link="mycobot_base_link"/>
    
    <disable_collisions link1="mycobot_base_link" link2="link1" reason="Adjacent"/>
    <disable_collisions link1="link1" link2="link2" reason="Adjacent"/>
    <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>
    <disable_collisions link1="link3" link2="link4" reason="Adjacent"/>
    <disable_collisions link1="link4" link2="link5" reason="Adjacent"/>
    <disable_collisions link1="link5" link2="link6" reason="Adjacent"/>
    <disable_collisions link1="link6" link2="camera_flange" reason="Adjacent"/>
    <disable_collisions link1="camera_flange" link2="pump_head" reason="Adjacent"/>
    <disable_collisions link1="link5" link2="camera_flange" reason="Never"/>
    <disable_collisions link1="link6" link2="pump_head" reason="Adjacent"/>
    <disable_collisions link1="link5" link2="pump_head" reason="Never"/>
    <disable_collisions link1="link6" link2="pump_box" reason="Never"/>
    <disable_collisions link1="pump_head" link2="pump_tcp" reason="Adjacent"/>
    <disable_collisions link1="mycobot_base_link" link2="pump_box" reason="Adjacent"/>
    <disable_collisions link1="link1" link2="pump_box" reason="Never"/>
    <disable_collisions link1="link2" link2="pump_box" reason="Never"/>
    <disable_collisions link1="link3" link2="pump_box" reason="Never"/>
    <disable_collisions link1="link4" link2="pump_box" reason="Never"/>
    <disable_collisions link1="link5" link2="pump_box" reason="Never"/>
</robot>
