<?xml version="1.1"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mycobot_280_jn">

  <material name="white"><color rgba="1 1 1 1"/></material>
  <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>

  <link name="mycobot_base_link">
    <visual>
      <geometry><mesh filename="package://mycobot_description/urdf/mycobot_280_jn/joint1_jet.dae"/></geometry>
      <origin xyz="0.0 0 0" rpy="0 0 3.14159"/>
    </visual>
    <!-- Colisão: caixa primitiva (bbox do mesh, 164x131x165mm). joint1_jet.dae
         também é COLLADA em mm e era carregado 1000x maior pelo MoveIt. -->
    <collision>
      <geometry><box size="0.164 0.131 0.165"/></geometry>
      <origin xyz="-0.0069 -0.0109 0.0274" rpy="0 0 0"/>
    </collision>
  </link>

  <link name="link1"><visual><geometry><mesh filename="package://mycobot_description/urdf/mycobot_280_jn/joint2.dae"/></geometry><origin xyz="0.0 0 -0.06096" rpy="0 0 -1.5708"/></visual></link>
  <link name="link2"><visual><geometry><mesh filename="package://mycobot_description/urdf/mycobot_280_jn/joint3.dae"/></geometry><origin xyz="0.0 0 0.03256" rpy="0 -1.5708 0"/></visual></link>
  <link name="link3"><visual><geometry><mesh filename="package://mycobot_description/urdf/mycobot_280_jn/joint4.dae"/></geometry><origin xyz="0.0 0 0.03056" rpy="0 -1.5708 0"/></visual></link>
  <link name="link4"><visual><geometry><mesh filename="package://mycobot_description/urdf/mycobot_280_jn/joint5.dae"/></geometry><origin xyz="0.0 0 -0.03356" rpy="0 -1.5708 1.5708"/></visual></link>
  <link name="link5"><visual><geometry><mesh filename="package://mycobot_description/urdf/mycobot_280_jn/joint6.dae"/></geometry><origin xyz="0 0.00 -0.038" rpy="0 0 0"/></visual></link>
  <link name="link6"><visual><geometry><mesh filename="package://mycobot_description/urdf/mycobot_280_jn/joint7.dae"/></geometry><origin xyz="0.0 0 -0.012" rpy="0 0 0"/><material name="grey"/></visual></link>

  <!-- Vertical Suction Pump V2.0 -->
  <link name="pump_box">
    <visual>
      <geometry><mesh filename="package://mycobot_description/urdf/mycobot_280_jn/pump_box.dae"/></geometry>
      <origin xyz="0.0 -0.15 -0.0" rpy="1.5708 3.14159 0"/>
    </visual>
    <!-- Colisão: caixa primitiva (bbox do mesh, 72x43x52mm). O loader de
         colisão do MoveIt (assimp) ignora <unit meter="0.001"> do COLLADA
         e carregava o mesh 1000x maior -> start state sempre inválido. -->
    <collision>
      <geometry><box size="0.072 0.043 0.052"/></geometry>
      <origin xyz="0.0 -0.15 -0.0135" rpy="1.5708 3.14159 0"/>
    </collision>
  </link>

  <!-- Camera flange oficial (AI Kit): monta ENTRE o flange e a pump.
       Mesh oficial mycobot_ros/noetic (COLLADA em mm → colisão por box
       primitiva, bbox 83x9x34.5mm). -->
  <link name="camera_flange">
    <visual>
      <geometry><mesh filename="package://mycobot_description/urdf/mycobot_280_jn/camera_flange.dae"/></geometry>
      <origin xyz="0.024 -0.008 0.0" rpy="0 3.14159 0"/>
    </visual>
    <collision>
      <geometry><box size="0.083 0.009 0.0345"/></geometry>
      <origin xyz="0.024 -0.0045 -0.0005" rpy="0 3.14159 0"/>
    </collision>
  </link>

  <link name="pump_head">
    <!-- Origens do modelo oficial COMBINADO camera_flange + pump
         (mycobot_280m5_with_camera_flange_pump.urdf) -->
    <visual>
      <geometry><mesh filename="package://mycobot_description/urdf/mycobot_280_jn/pump_head.dae"/></geometry>
      <origin xyz="0.0 0.008 0.009" rpy="1.5708 0 0"/>
    </visual>
    <!-- Colisão: caixa primitiva (bbox do mesh, 24.5x63x26.7mm), mesmo
         motivo do pump_box (mesh COLLADA em mm carregado 1000x maior). -->
    <collision>
      <geometry><box size="0.0245 0.063 0.0267"/></geometry>
      <origin xyz="0.0 0.0091 0.0405" rpy="1.5708 0 0"/>
    </collision>
  </link>

  <!-- suction cup tip frame (TCP) -->
  <link name="pump_tcp"/>

  <joint name="joint2_to_joint1" type="revolute">
    <axis xyz="0 0 1"/><limit effort="1000.0" lower="-2.9321" upper="2.9321" velocity="3.14"/>
    <parent link="mycobot_base_link"/><child link="link1"/><origin xyz="0 0 0.15756" rpy="0 0 0"/>
  </joint>

  <joint name="joint3_to_joint2" type="revolute">
    <axis xyz="0 0 1"/><limit effort="1000.0" lower="-2.4434" upper="2.4434" velocity="3.14"/>
    <parent link="link1"/><child link="link2"/><origin xyz="0 0 -0.001" rpy="0 1.5708 -1.5708"/>
  </joint>

  <joint name="joint4_to_joint3" type="revolute">
    <axis xyz="0 0 1"/><limit effort="1000.0" lower="-2.6179" upper="2.6179" velocity="3.14"/>
    <parent link="link2"/><child link="link3"/><origin xyz="-0.1104 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="joint5_to_joint4" type="revolute">
    <axis xyz="0 0 1"/><limit effort="1000.0" lower="-2.6179" upper="2.6179" velocity="3.14"/>
    <parent link="link3"/><child link="link4"/><origin xyz="-0.096 0 0.06462" rpy="0 0 -1.5708"/>
  </joint>

  <joint name="joint6_to_joint5" type="revolute">
    <axis xyz="0 0 1"/><limit effort="1000.0" lower="-2.7052" upper="2.7925" velocity="3.14"/>
    <parent link="link4"/><child link="link5"/><origin xyz="0 -0.07318 0" rpy="1.5708 -1.5708 0"/>
  </joint>

  <joint name="joint6output_to_joint6" type="revolute">
    <axis xyz="0 0 1"/><limit effort="1000.0" lower="-3.14159" upper="3.14159" velocity="3.14"/>
    <parent link="link5"/><child link="link6"/><origin xyz="0 0.0456 0" rpy="-1.5708 0 0"/>
  </joint>

  <!-- Pump box mounted on base link (physical box sits near the robot base) -->
  <joint name="base_to_pump_box" type="fixed">
    <parent link="mycobot_base_link"/><child link="pump_box"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Camera flange no flange do link6 (transform oficial) -->
  <joint name="link6_to_camera_flange" type="fixed">
    <parent link="link6"/><child link="camera_flange"/>
    <origin xyz="0 0 0.01" rpy="1.579 0 0"/>
  </joint>

  <!-- Pump pendurada NA camera flange (transform oficial do combinado) -->
  <joint name="camera_flange_to_pump_head" type="fixed">
    <parent link="camera_flange"/><child link="pump_head"/>
    <origin xyz="0 0 0.01" rpy="-1.579 0 0"/>
  </joint>

  <!-- TCP na face do copo de sucção.
       Mesh (mm): anel Ø20 em (0, 11.66, -14.45) olhando -z do mesh.
       Com a origem visual oficial (0, 0.008, 0.009, rpy 1.5708 0 0),
       o copo fica em (0, 0.02245, 0.02066) no frame pump_head, sucção
       para +y_ph. rpy=(-pi/2,0,0) põe o z do TCP saindo do copo —
       no link6 isso é +y (FK verificado: copo em (0, 0.0125, 0.0306)). -->
  <joint name="pump_head_to_tcp" type="fixed">
    <parent link="pump_head"/><child link="pump_tcp"/>
    <origin xyz="0 0.02245 0.02066" rpy="-1.5708 0 0"/>
  </joint>

  <!-- Frame óptico da câmera (convenção ROS: z sai da lente).
       A câmera do flange olha na direção do copo (-z da camera_flange).
       Posição aproximada no centro da placa — CALIBRAR no robô real. -->
  <link name="camera_optical"/>
  <joint name="camera_flange_to_optical" type="fixed">
    <parent link="camera_flange"/><child link="camera_optical"/>
    <origin xyz="0.024 -0.0045 -0.017" rpy="3.14159 0 0"/>
  </joint>

</robot>
